<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout android:id="@+id/appBarLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/primary">

        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" app:navigationIcon="@drawable/ic_back" app:navigationIconTint="@color/white" app:titleTextColor="@color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="@dimen/bottom_bar_height">

            <ImageView android:id="@+id/productHeroImage" android:layout_width="0dp" android:layout_height="@dimen/product_hero_image_height" android:scaleType="centerCrop" android:contentDescription="@string/product_image" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" tools:src="@android:color/darker_gray" />

            <TextView android:id="@+id/productName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_margin="@dimen/margin_medium" android:textAppearance="@style/TextAppearance.Yanthraa.Headline" app:layout_constraintTop_toBottomOf="@id/productHeroImage" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" tools:text="Product Name" />

            <TextView android:id="@+id/productPrice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/margin_medium" android:layout_marginTop="@dimen/spacing_small" android:textAppearance="@style/TextAppearance.Yanthraa.Price" android:textSize="@dimen/text_size_large" app:layout_constraintTop_toBottomOf="@id/productName" app:layout_constraintStart_toStartOf="parent" tools:text="$199.99" />

            <RatingBar android:id="@+id/productRating" style="?android:attr/ratingBarStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_medium" android:numStars="5" android:stepSize="0.1" android:isIndicator="true" android:progressTint="@color/star_filled" android:secondaryProgressTint="@color/star_empty" app:layout_constraintTop_toTopOf="@id/productPrice" app:layout_constraintBottom_toBottomOf="@id/productPrice" app:layout_constraintStart_toEndOf="@id/productPrice" tools:rating="4.5" />

            <TextView android:id="@+id/ratingText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_tiny" android:textColor="@color/text_secondary" android:textSize="@dimen/text_size_small" app:layout_constraintTop_toTopOf="@id/productRating" app:layout_constraintBottom_toBottomOf="@id/productRating" app:layout_constraintStart_toEndOf="@id/productRating" tools:text="(4.5)" />

            <TextView android:id="@+id/descriptionLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/margin_medium" android:layout_marginTop="@dimen/spacing_large" android:layout_marginEnd="@dimen/margin_medium" android:text="@string/description" android:textAppearance="@style/TextAppearance.Yanthraa.Title" app:layout_constraintTop_toBottomOf="@id/productPrice" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

            <TextView android:id="@+id/productDescription" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/margin_medium" android:layout_marginTop="@dimen/spacing_small" android:layout_marginEnd="@dimen/margin_medium" android:textAppearance="@style/TextAppearance.Yanthraa.Body" android:lineSpacingExtra="4dp" app:layout_constraintTop_toBottomOf="@id/descriptionLabel" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" tools:text="Product description goes here with all the details about the product." />

            <TextView android:id="@+id/quantityLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/margin_medium" android:layout_marginTop="@dimen/spacing_large" android:text="@string/quantity" android:textAppearance="@style/TextAppearance.Yanthraa.Title" app:layout_constraintTop_toBottomOf="@id/productDescription" app:layout_constraintStart_toStartOf="parent" />

            <LinearLayout android:id="@+id/quantitySelector" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/quantity_selector_background" android:layout_marginTop="@dimen/spacing_small" android:layout_marginStart="@dimen/margin_medium" android:layout_marginBottom="@dimen/margin_medium" app:layout_constraintTop_toBottomOf="@id/quantityLabel" app:layout_constraintStart_toStartOf="parent" app:layout_constraintBottom_toBottomOf="parent">

                <ImageButton android:id="@+id/decrementButton" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_remove" android:contentDescription="@string/decrement_quantity" app:tint="@color/primary" />

                <TextView android:id="@+id/quantityText" android:layout_width="48dp" android:layout_height="40dp" android:gravity="center" android:text="1" android:textAppearance="@style/TextAppearance.Yanthraa.Title" android:textSize="18sp" />

                <ImageButton android:id="@+id/incrementButton" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_add" android:contentDescription="@string/increment_quantity" app:tint="@color/primary" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Sticky Bottom Bar -->
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" app:cardElevation="16dp" app:cardCornerRadius="0dp" app:cardBackgroundColor="@color/surface">

        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="@dimen/padding_medium">

            <com.google.android.material.button.MaterialButton android:id="@+id/addToCartButton" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/add_to_cart" android:textSize="18sp" android:textStyle="bold" style="@style/Widget.Yanthraa.Button.Primary" app:cornerRadius="12dp" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
